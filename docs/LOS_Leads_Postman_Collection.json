        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobileNumber\": \"9876543210\",\n  \"customerType\": \"Corporate\",\n  \"loanAmount\": 1500000.0,\n  \"tenure\": 48,\n  \"numberOfInstalments\": 48,\n  \"emi\": 39200.0,\n  \"annualIncome\": 2100000.0,\n  \"designation\": \"Lead Architect\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/leads/{{leadId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
