            "leads",
            "{{leadId}}"
          ]
        },
        "description": "Updates editable attributes of an existing lead while keeping system identifiers intact."
      },
      "response": []
    },
    {
      "name": "6. Assign Lead to Maker User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeId\": \"EMP-HDFC-002\",\n  \"assignedBy\": \"EMP-HDFC01-47AA80\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/leads/{{leadId}}/assign",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "leads",
            "{{leadId}}",
            "assign"
          ]
        },
        "description": "Assigns lead to an active Maker user (e.g. EMP-HDFC-002). Sets leadStatus = ASSIGNED."
      },
      "response": []
    },
    {
      "name": "7. Bulk Import Leads (CSV)",
