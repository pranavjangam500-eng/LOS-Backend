{
  "info": {
    "_postman_id": "c71a3962-43bb-4d2b-9e81-81d3f9e9842a",
    "name": "LOS Lead Management API Collection",
    "description": "Comprehensive Postman Collection for testing all Lead Management endpoints across the 4-section multi-step flow:\n1. Personal Details\n2. Loan Details\n3. Income Profile\n4. Referral Details\nIncludes Authentication, Lead Creation, Retrieval, Updates, Assignment, Search, and Bulk CSV Import/Export.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "lead_id",
      "value": "LD2026100001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "0.1 Bank User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hdfcbank.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates bank staff or admin. Returns JWT accessToken directly or an OTP challenge with tempSessionToken."
          },
          "response": []
        },
        {
          "name": "0.2 Verify 2FA OTP (if required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tempSessionToken\": \"{{temp_session_token}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Completes 2-factor authentication and returns the Bearer access token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Lead Lifecycle Operations",
      "item": [
        {
          "name": "1.1 Preview Next Lead ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads/next-id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "next-id"
              ]
            },
            "description": "Previews the next sequential Lead ID (format: LDYYYYMM####, e.g. LD2026100001)."
          },
          "response": []
        },
        {
          "name": "1.2 Create Lead (Full 4 Sections)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.leadId) {",
                  "    pm.collectionVariables.set('lead_id', jsonData.leadId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Siddharth Rao\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"age\": 36,\n  \"customerType\": \"Individual\",\n  \"passportExpiryDate\": \"2032-05-19\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"panValidationStatus\": \"VALID\",\n  \"aadhaarNumber\": \"123456789012\",\n  \"aadhaarValidationStatus\": \"VALID\",\n  \"residentialStatus\": \"Resident Indian\",\n  \"gender\": \"Male\",\n  \"maritalStatus\": \"Married\",\n  \"passportNumber\": \"P9876543\",\n  \"dedupeStatus\": \"NO_DUPLICATE\",\n  \"blacklistStatus\": \"CLEAR\",\n  \"loanProductType\": \"Personal Loan\",\n  \"loanAmount\": 1200000.0,\n  \"interestRate\": 11.5,\n  \"totalInterest\": 244428.0,\n  \"purposeOfLoan\": \"Home Renovation\",\n  \"tenure\": 36,\n  \"numberOfInstalments\": 36,\n  \"emi\": 40123.0,\n  \"securityAmount\": 200000.0,\n  \"employmentType\": \"Salaried\",\n  \"annualIncome\": 1800000.0,\n  \"designation\": \"Senior Tech Lead\",\n  \"employerName\": \"Infosys Technologies Ltd\",\n  \"location\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"takeHomePay\": 125000.0,\n  \"deductionsOrEmisPayable\": 15000.0,\n  \"bankName\": \"HDFC Bank\",\n  \"accountNumber\": \"50100456789012\",\n  \"accountStatementConsent\": true,\n  \"cibilLiabilityCheck\": \"CHECKED_CLEAR\",\n  \"debtToIncomeRatio\": 44.09,\n  \"loanToValueRatio\": 66.67,\n  \"debtServiceCoverageRatio\": 2.27,\n  \"netDisposableIncome\": 69877.0,\n  \"leadAcquisitionChannel\": \"Partner Network\",\n  \"date\": \"2026-10-05\",\n  \"sourcingAgentPartnerId\": \"AGT-770\",\n  \"agentPartnerName\": \"Rahul Saxena\",\n  \"employeeId\": \"EMP101\",\n  \"employeeName\": \"Anita Roy\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "Creates a new Lead covering Personal Details, Loan Details, Income Profile, and Referral Details in a single atomic request. Status defaults to NEW."
          },
          "response": []
        },
        {
          "name": "1.3 Get Lead by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": "Retrieves the full Lead object with all 4 sections by Lead ID."
          },
          "response": []
        },
        {
          "name": "1.4 Get All Leads (List & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "Returns list of all leads stored in the current tenant database."
          },
          "response": []
        },
        {
          "name": "1.5 Update Lead (Edit Details)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Siddharth Rao\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"age\": 36,\n  \"customerType\": \"Individual\",\n  \"passportExpiryDate\": \"2032-05-19\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"panValidationStatus\": \"VALID\",\n  \"aadhaarNumber\": \"123456789012\",\n  \"aadhaarValidationStatus\": \"VALID\",\n  \"residentialStatus\": \"Resident Indian\",\n  \"gender\": \"Male\",\n  \"maritalStatus\": \"Married\",\n  \"passportNumber\": \"Z1122334\",\n  \"dedupeStatus\": \"NO_DUPLICATE\",\n  \"blacklistStatus\": \"CLEAR\",\n  \"loanProductType\": \"Personal Loan\",\n  \"loanAmount\": 1300000.0,\n  \"interestRate\": 12.0,\n  \"totalInterest\": 264812.0,\n  \"purposeOfLoan\": \"Home Renovation\",\n  \"tenure\": 36,\n  \"numberOfInstalments\": 36,\n  \"emi\": 43467.0,\n  \"securityAmount\": 200000.0,\n  \"employmentType\": \"Salaried\",\n  \"annualIncome\": 1900000.0,\n  \"designation\": \"Principal Architect\",\n  \"employerName\": \"Infosys Global Technologies\",\n  \"location\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"takeHomePay\": 135000.0,\n  \"deductionsOrEmisPayable\": 15000.0,\n  \"bankName\": \"HDFC Bank\",\n  \"accountNumber\": \"50100456789012\",\n  \"accountStatementConsent\": true,\n  \"cibilLiabilityCheck\": \"CHECKED_CLEAR\",\n  \"debtToIncomeRatio\": 43.12,\n  \"loanToValueRatio\": 72.22,\n  \"debtServiceCoverageRatio\": 2.31,\n  \"netDisposableIncome\": 76533.0,\n  \"leadAcquisitionChannel\": \"Partner Network\",\n  \"date\": \"2026-10-05\",\n  \"sourcingAgentPartnerId\": \"AGT-770\",\n  \"agentPartnerName\": \"Rahul Saxena\",\n  \"employeeId\": \"EMP101\",\n  \"employeeName\": \"Anita Roy\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads/{{lead_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "{{lead_id}}"
              ]
            },
            "description": "Updates non-system fields of an existing lead while preserving lead ID and system status."
          },
          "response": []
        },
        {
          "name": "1.6 Assign Lead to Maker",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"EMP-HDFC-002\",\n  \"assignedBy\": \"EMP-HDFC-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads/{{lead_id}}/assign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "{{lead_id}}",
                "assign"
              ]
            },
            "description": "Assigns lead to an active Maker user. Updates leadStatus to ASSIGNED."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Bulk CSV Import and Export",
      "item": [
        {
          "name": "2.1 Download Sample CSV Template",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads/sample-csv",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "sample-csv"
              ]
            },
            "description": "Downloads the pre-configured sample_leads.csv with all 56 fields ordered across the 4 sections."
          },
          "response": []
        },
        {
          "name": "2.2 Export All Leads to CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads/export",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "export"
              ]
            },
            "description": "Exports all leads to leads.csv attachment."
          },
          "response": []
        },
        {
          "name": "2.3 Bulk Import Leads from CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_leads.csv",
                  "description": "Select sample_leads.csv file to upload"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/leads/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "import"
              ]
            },
            "description": "Bulk imports leads from multipart CSV file. Validates each row and reports created leads and errors."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Validation and Negative Test Cases",
      "item": [
        {
          "name": "3.1 Validation Error - Missing Mandatory Customer Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"\",\n  \"loanProductType\": \"Personal Loan\",\n  \"loanAmount\": 500000.0,\n  \"leadAcquisitionChannel\": \"Website\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "Should return HTTP 400 Bad Request with validation error message."
          },
          "response": []
        },
        {
          "name": "3.2 Validation Error - Invalid Passport Expiry Date Format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Rajiv Kapoor\",\n  \"passportExpiryDate\": \"invalid-date\",\n  \"loanProductType\": \"Home Loan\",\n  \"loanAmount\": 2500000.0,\n  \"leadAcquisitionChannel\": \"Website\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "Should return HTTP 400 Bad Request: Passport Expiry Date must be a valid date in YYYY-MM-DD format."
          },
          "response": []
        },
        {
          "name": "3.3 Validation Error - Negative Loan Amount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ananya Sen\",\n  \"loanProductType\": \"Home Loan\",\n  \"loanAmount\": -50000.0,\n  \"leadAcquisitionChannel\": \"Website\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            },
            "description": "Should return HTTP 400 Bad Request: Loan Amount must be greater than zero."
          },
          "response": []
        },
        {
          "name": "3.4 Lead Not Found (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/leads/NON_EXISTENT_ID",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "NON_EXISTENT_ID"
              ]
            },
            "description": "Should return HTTP 404 Not Found."
          },
          "response": []
        }
      ]
    }
  ]
}