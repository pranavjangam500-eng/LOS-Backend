            "url": {
              "raw": "{{base_url}}/api/v1/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "otp",
                "verify"
              ]
            },
            "description": "Submitting the same OTP code twice will fail on the second attempt because the code is instantly purged upon initial verification."
          },
          "response": []
