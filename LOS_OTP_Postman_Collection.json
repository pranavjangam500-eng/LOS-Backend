{
  "info": {
    "_postman_id": "a9d72e61-8910-4bf2-a589-9cb8e5c26b91",
    "name": "LOS Email OTP Authentication API Collection",
    "description": "Ready-to-use Postman Collection for Frontend Developers integrating the Email OTP service into web, mobile, and customer onboarding applications.\n\n### Endpoints Supported:\n- `POST /api/v1/otp/send` & `POST /api/otp/send`: Generates and dispatches 6-digit cryptographic OTP to email.\n- `POST /api/v1/otp/verify` & `POST /api/otp/verify`: Verifies code with attempt tracking (max 5) and single-use protection.\n\n### Base URL:\nDefault is `http://localhost:8080`. No Bearer token or authorization header required (public endpoints).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "demo@allianzapay.com",
      "type": "string"
    },
    {
      "key": "test_otp",
      "value": "123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Send OTP",
      "item": [
        {
          "name": "1.1 Send OTP (Primary API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "otp",
                "send"
              ]
            },
            "description": "Sends a 6-digit numeric OTP to the provided email. Triggers real SMTP email or simulation if SMTP is unconfigured."
          },
          "response": [
            {
              "name": "Success Response (200 OK)",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"demo@allianzapay.com\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/otp/send",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "otp",
                    "send"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"OTP sent successfully to demo@allianzapay.com.\"\n}"
            },
