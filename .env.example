# =======================================================
# LOS Backend - Environment Variables Template
# Copy this file to .env (ignored by Git).
# =======================================================

# Active Spring Profile (use 'dev' for PostgreSQL on Render)
SPRING_PROFILES_ACTIVE=dev

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://system-los.vercel.app,https://system-rimge9vct-pranav-3745.vercel.app,https://los-application.vercel.app

# --- Master Database ---
MASTER_DB_URL=jdbc:postgresql://localhost:5432/los_master_db
MASTER_DB_USERNAME=postgres
MASTER_DB_PASSWORD=your_master_db_password

# --- Bank Database (Template for Dynamic Routing) ---
BANK_DB_HOST=localhost
BANK_DB_PORT=5432
BANK_DB_USERNAME=postgres
BANK_DB_PASSWORD=your_bank_db_password

# --- Gmail / SMTP Mail Configuration (Email OTP Service - works locally) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=demo@allianzapay.com
SMTP_USER=demo@allianzapay.com
SMTP_APP_PASSWORD=uvlg vxhg zadx kcig
SMTP_PASS=uvlg vxhg zadx kcig
SMTP_FROM="OTP Auth Service" <demo@allianzapay.com>

# --- Cloud HTTPS Email API (Optional - for Render Free Tier which blocks port 587) ---
# Option 1: Brevo (Sendinblue) - 300 free emails/day. Get key at https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...
# Option 2: Resend - 100 free emails/day. Get key at https://resend.com
# RESEND_API_KEY=re_...



