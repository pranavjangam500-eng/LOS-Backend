# =======================================================
# LOS Backend - Environment Variables Template
# Copy this file to .env or export these in your terminal.
# =======================================================

# Active Spring Profile (use 'dev' for PostgreSQL, 'local' for in-memory)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# --- Master Database ---
MASTER_DB_URL=jdbc:postgresql://192.168.0.193:5432/los_master_db
MASTER_DB_USERNAME=pranav
MASTER_DB_PASSWORD=your_password_here

# --- Tenant Database (base template for dynamic routing) ---
TENANT_DB_HOST=192.168.0.193
TENANT_DB_PORT=5432
TENANT_DB_USERNAME=pranav
TENANT_DB_PASSWORD=your_password_here

# --- JWT Security (Optional overrides) ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
ACCESS_TOKEN_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000
